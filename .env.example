# MediKiosk Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to source control.

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Obtain from https://aistudio.google.com/app/apikey
# This key is used SERVER-SIDE ONLY. It must never appear in the browser bundle.
GEMINI_API_KEY=your_gemini_api_key_here

# ── AI Model Selection ────────────────────────────────────────────────────────
# Default model to use for all Gemini calls.
# Recommended: gemini-2.5-flash  (fast, low-cost, excellent for NLU tasks)
GEMINI_MODEL=gemini-2.5-flash

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Set to "true" to force MockAIService even when GEMINI_API_KEY is present.
# Useful for offline development / CI environments.
USE_MOCK_AI=false

# ── App Config ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=MediKiosk
NEXT_PUBLIC_APP_VERSION=2.0.0
